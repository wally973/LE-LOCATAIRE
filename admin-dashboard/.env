###############################################
# 🔧 CONFIGURATION FRONTEND (VITE)
###############################################

# URL du backend NestJS en production
# Exemple : https://api.lelocataire.com
VITE_API_URL=https://ton-backend.com


###############################################
# 🌐 CONFIGURATION DEV (LOCAL)
###############################################

# Si tu veux utiliser le backend local :
# VITE_API_URL=http://localhost:3000


###############################################
# 🔐 AUTH / TOKENS (si nécessaire plus tard)
###############################################

# Durée d’expiration du token côté front (optionnel)
VITE_ACCESS_TOKEN_EXPIRES=3600

# Nom de la clé locale pour stocker le token
VITE_STORAGE_TOKEN_KEY=admin_access_token

# Nom de la clé locale pour stocker le refresh token
VITE_STORAGE_REFRESH_KEY=admin_refresh_token


###############################################
# 🎨 UI / DASHBOARD
###############################################

# Thème par défaut : light | dark
VITE_DEFAULT_THEME=light

# Taille de page par défaut pour la pagination
VITE_DEFAULT_PAGE_SIZE=10


###############################################
# 🧪 MODE DEBUG
###############################################

# Active les logs détaillés dans la console
VITE_DEBUG=false
