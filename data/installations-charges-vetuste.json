  "principles": {
    "reparationsLocatives": {
      "texte": "Décret n°87-712",
      "resume": "Entretien courant et menues réparations liées à l’usage normal des locaux et équipements privatifs → locataire, liste limitative en annexe.",
      "horsListe": "Tout ce qui n’est pas réparation locative → bailleur (grosses réparations, structure, réseaux collectifs, décence)."
    },
    "vetuste": {
      "definition": "Usure normale due au temps et à l’usage (art. 7 loi 89-462, décret 2016-382).",
      "regle": "Si la réparation est rendue nécessaire par la vétusté ou la force majeure → charge bailleur, même si l’acte figure au décret 87-712 (Service Public F31699, F21105).",
      "grilleContractuelle": {
        "obligatoire": false,
        "quand": "Annexée au bail ou à l’EDL si les parties choisissent une grille issue d’un accord collectif.",
        "parametres": ["dureeVieTheoriqueAnnees", "franchiseAnnees", "tauxAbattementAnnuelPct"],
        "formuleIndicative": "vetustePct = min(100, max(0, (anneesOccupation - franchise) × tauxAbattementAnnuelPct))",
        "partLocataireIndicative": "coutTravaux × (1 - vetustePct/100) — surtout utile à la sortie, pas pendant le bail."
      }
    },
    "chargesRecuperables": {
      "texte": "Décret n°87-713",
      "note": "Charges locatives (eau/chauffage collectif, ascenseur, TEOM…) — distinct des réparations sur installations du logement."
    }
  },
