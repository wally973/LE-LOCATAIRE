# Copier vers .env et renseigner les valeurs (ne pas committer .env).

DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
JWT_SECRET="change-me"

# --- Notifications (Sprint 6B) ---
# Sans SMTP : emails loggés en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@votredomaine.fr"
SMTP_SECURE=false
NOTIFICATIONS_EMAIL_ENABLED=true

# Sans Firebase : push loggés en console.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée sur une ligne avec \n échappés
FIREBASE_PRIVATE_KEY=
# OU chemin vers le JSON service account :
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATIONS_PUSH_ENABLED=true

# --- Lia / hôte d'accueil (Sprint F) ---
# Sans GROQ_API_KEY : messages d'accueil en texte fixe (fallback).
GROQ_API_KEY=
LIA_HOST_MODEL=llama-3.1-8b-instant
LIA_HOST_BASE_URL=https://api.groq.com/openai/v1
LIA_HOST_ENABLED=true

# --- Pipeline IA tickets (Sprint G) ---
# stub = ancien mots-clés | lia = pathologiste + juriste | auto = lia si clés API
AI_PIPELINE_MODE=lia
# Pathologiste (Gemini Vision) — sans clé : simulation interne
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LIA_PATHOLOGIST_ENABLED=true
# Juriste (Mistral + AiMemory) — sans clé : règles + mémoire seed
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LIA_JURIST_ENABLED=true
