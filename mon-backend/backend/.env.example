# Copier vers .env et renseigner les valeurs (ne pas committer .env).

DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
JWT_SECRET="change-me"

# URL publique du backend (téléphones / photos) — ex. http://192.168.1.16:3000
PUBLIC_API_BASE_URL="http://192.168.1.16:3000"

# --- Notifications (Sprint 6B) ---
# Sans SMTP : emails loggés en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@votredomaine.fr"
SMTP_SECURE=false
NOTIFICATIONS_EMAIL_ENABLED=true

# Sans Firebase : push loggés en console.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée sur une ligne avec \n échappés
FIREBASE_PRIVATE_KEY=
# OU chemin vers le JSON service account :
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATIONS_PUSH_ENABLED=true

# --- Mistral — Grock (Intercom mono-agent) + juriste ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
# Grock (prioritaire sur MISTRAL_MODEL si défini)
GROCK_MODEL=mistral-small-latest
GROCK_FALLBACK_MODEL=open-mistral-nemo

# --- Lia / hôte d'accueil legacy (Groq — optionnel) ---
# Sans GROQ_API_KEY : messages d'accueil Lia en texte fixe (fallback).
GROQ_API_KEY=
LIA_HOST_MODEL=llama-3.1-8b-instant
LIA_HOST_BASE_URL=https://api.groq.com/openai/v1
LIA_HOST_ENABLED=true
GROQ_INTERCOM_MODEL=llama-3.1-8b-instant

# --- Pont LLM Jarvis (moteur principal intake) ---
# true par défaut si MISTRAL_API_KEY ou GROQ_API_KEY est renseignée.
JARVIS_LLM_BRIDGE=true
# Repli sur moteur script si Groq échoue (déconseillé en prod).
JARVIS_LLM_BRIDGE_FALLBACK=false
JARVIS_LLM_BRIDGE_TIMEOUT_MS=10000
JARVIS_LLM_BRIDGE_MAX_TOKENS=900
# Ancien polish optionnel (remplacé par le pont LLM).
# JARVIS_LLM_POLISH=true

# --- Lia-Lab (intercom Jarvis — ADMIN) ---
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Pipeline IA tickets (Sprint G) ---
# stub = ancien mots-clés | lia = pathologiste + juriste | auto = lia si clés API
AI_PIPELINE_MODE=lia
# Pathologiste (Gemini Vision) — sans clé : simulation interne
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LIA_PATHOLOGIST_ENABLED=true
# Juriste (Mistral + AiMemory) — même clé que Grock
LIA_JURIST_ENABLED=true
