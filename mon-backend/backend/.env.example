# Copier vers .env et renseigner les valeurs (ne pas committer .env).

DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
JWT_SECRET="change-me"

# --- Notifications (Sprint 6B) ---
# Sans SMTP : emails loggés en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@votredomaine.fr"
SMTP_SECURE=false
NOTIFICATIONS_EMAIL_ENABLED=true

# Sans Firebase : push loggés en console.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée sur une ligne avec \n échappés
FIREBASE_PRIVATE_KEY=
# OU chemin vers le JSON service account :
GOOGLE_APPLICATION_CREDENTIALS=
NOTIFICATIONS_PUSH_ENABLED=true
