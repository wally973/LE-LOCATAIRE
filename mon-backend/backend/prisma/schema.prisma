generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          Int                         @id @default(autoincrement())
  email                       String?
  createdAt                   DateTime                    @default(now())
  password                    String
  phone                       String                      @unique
  updatedAt                   DateTime                    @updatedAt
  role                        Role                        @default(LOCATAIRE)
  isAvailable                 Boolean                     @default(true)
  adminAuditLogs              AdminAuditLog[]
  invoicesAsLandlord          Invoice[]                   @relation("InvoiceLandlord")
  landlord                    LandlordProfile?
  /// Profil agent — non null si role = AGENT (rattaché à un bailleur, optionnellement à une agence)
  agent                       AgentProfile?
  notifications               Notification[]
  /// Sprint 6B — préférences canaux (email / push)
  notificationSettings        UserNotificationSettings?
  devicePushTokens            DevicePushToken[]
  planningSlots               PlanningSlot[]              @relation("PlanningSlotArtisan")
  socialWorkers               SocialWorker[]
  /// Actions enregistrées sur les dossiers sociaux (journal Sprint 5)
  socialCaseEventsAuthored    SocialCaseEvent[]
  supportTickets              SupportTicket[]
  tenant                      TenantProfile?
  /// Demandes d'inscription locataire en attente / historisées de l'utilisateur
  tenantRegistrationRequests  TenantRegistrationRequest[]
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  actorId    Int
  actorEmail String?
  action     String
  entityType String
  entityId   Int?
  metadata   Json?
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

/// Contrat de location reliant LandlordProfile (bailleur), TenantProfile (locataire) et Housing (logement).
/// Source de vérité pour la relation contractuelle : dates, loyer, dépôt de garantie, statut.
model ContratLocation {
  id                Int       @id @default(autoincrement())
  landlordProfileId Int
  tenantProfileId   Int
  housingId         Int
  dateDebut         DateTime
  dateFin           DateTime?
  loyerMensuel      Float
  depotGarantie     Float?
  /// ACTIF, RESILIE, EN_ATTENTE, etc.
  statut            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  landlord LandlordProfile @relation(fields: [landlordProfileId], references: [id], onDelete: Restrict)
  tenant   TenantProfile   @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict)
  housing  Housing         @relation(fields: [housingId], references: [id], onDelete: Restrict)

  paiements Paiement[]

  @@index([landlordProfileId])
  @@index([tenantProfileId])
  @@index([housingId])
}

model Paiement {
  id            Int      @id @default(autoincrement())
  contratId     Int
  datePaiement  DateTime
  montant       Float
  /// CB, VIREMENT, ESPECES, CHEQUE
  moyenPaiement String
  /// PAYE, EN_RETARD, PARTIEL, ANNULE
  statut        String
  reference     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contrat ContratLocation @relation(fields: [contratId], references: [id], onDelete: Restrict)

  @@index([contratId])
}

model LandlordProfile {
  id                    Int               @id @default(autoincrement())
  name                  String
  logoUrl               String?
  userId                Int               @unique
  gpaServiceEmail       String?
  gpaServicePhone       String?
  /// Fusion HLM — service GPA interne (email / téléphone dédiés)
  hasInternalGPAService Boolean           @default(false)
  /// Fusion HLM — lien 1:1 optionnel vers entité patrimoine étendue (résidences / garanties)
  hlmBailleurId         String?           @unique
  housings              Housing[]
  hlmBailleur           HlmBailleur?      @relation(fields: [hlmBailleurId], references: [id])
  user                  User              @relation(fields: [userId], references: [id])
  socialCases           SocialCase[]
  socialWorkers         SocialWorker[]
  /// Multi-tenant : agences/gérances rattachées à ce bailleur (hiérarchie souple)
  agences               Agence[]
  /// Multi-tenant : agents (rôle AGENT) sous autorisation de ce bailleur
  agents                AgentProfile[]
  /// Contrats de location dont ce bailleur est partie
  contratsLocation      ContratLocation[]
  /// Demandes d'inscription locataire en attente / historisées pour ce bailleur
  tenantRequests        TenantRegistrationRequest[]
  /// Sprint 4 : demandes d'artisan ouvertes par les locataires de ce bailleur (visibilité)
  artisanRequests       ArtisanRequest[]
  /// Sprint 6A — modules activés pour ce bailleur (admin plateforme)
  featureFlags          LandlordFeatureFlags?
}

/// Agence / gérance d'un bailleur — entité optionnelle de regroupement (secteur géographique, équipe).
/// Un bailleur peut n'avoir aucune agence (structure simple) ou plusieurs (maison maîtresse + filiales).
model Agence {
  id                Int      @id @default(autoincrement())
  name              String
  address           String?
  city              City?
  postalCode        String?
  phone             String?
  email             String?
  landlordProfileId Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  landlord LandlordProfile @relation(fields: [landlordProfileId], references: [id], onDelete: Cascade)
  agents   AgentProfile[]
  housings Housing[]

  @@index([landlordProfileId])
}

/// Profil agent (rôle AGENT) — un agent travaille pour un bailleur et optionnellement dans une agence.
/// La granularité des permissions sera ajoutée plus tard ; pour l'instant un agent a accès à toutes les
/// réclamations du périmètre de son bailleur (ou de son agence si rattaché à une).
model AgentProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  landlordProfileId Int
  agenceId          Int?
  fonction          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  landlord LandlordProfile @relation(fields: [landlordProfileId], references: [id], onDelete: Cascade)
  agence   Agence?         @relation(fields: [agenceId], references: [id], onDelete: SetNull)

  @@index([landlordProfileId])
  @@index([agenceId])
}

model Housing {
  id                Int                    @id @default(autoincrement())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  address           String
  city              City
  postalCode        String
  country           String                 @default("FRANCE")
  isInGuyane        Boolean                @default(true)
  externalRef       String?
  isValidated       Boolean                @default(false)
  validationComment String?
  landlordId        Int
  /// Rattachement optionnel à une agence/secteur (routage des tickets vers l'équipe responsable)
  agenceId          Int?
  /// Fusion HLM — lien optionnel vers logement patrimoine (résidence / entretiens)
  hlmLogementId     String?                @unique
  documents         Document[]
  hlmLogement       HlmLogement?           @relation(fields: [hlmLogementId], references: [id])
  landlord          LandlordProfile        @relation(fields: [landlordId], references: [id])
  agence            Agence?                @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  tenantsHistory    TenantHousingHistory[]
  currentTenant     TenantProfile?         @relation("CurrentTenantHousing")
  tickets           Ticket[]
  contratsLocation  ContratLocation[]
  /// Demandes d'inscription locataire ayant été validées sur ce logement (historique)
  tenantRequestsApproved TenantRegistrationRequest[] @relation("ApprovedHousing")

  @@index([landlordId])
  @@index([agenceId])
}

model TenantProfile {
  id               Int                    @id @default(autoincrement())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  firstName        String
  lastName         String
  userId           Int                    @unique
  housingId        Int?                   @unique
  isOfficialTenant Boolean                @default(false)
  /// Dossier locataire unique (ex. DOS-000042) — historique des demandes
  dossierNumber    String?                @unique
  /// Fusion HLM — sujet Supabase Auth (sub JWT)
  authSubject      String?                @unique
  /// Fusion HLM — lien optionnel vers profil locataire métier UUID (socle)
  hlmLocataireId   String?                @unique
  documents        Document[]
  socialCases      SocialCase[]
  history          TenantHousingHistory[]
  hlmLocataire     HlmLocataire?          @relation(fields: [hlmLocataireId], references: [id])
  housing          Housing?               @relation("CurrentTenantHousing", fields: [housingId], references: [id])
  user             User                   @relation(fields: [userId], references: [id])
  tickets          Ticket[]
  contratsLocation ContratLocation[]
  /// Si ce profil a été créé via une demande self-service, lien optionnel vers la demande d'origine
  originRegistrationRequest TenantRegistrationRequest? @relation("ApprovedTenantProfile")
  /// Sprint 4 : demandes d'artisan ouvertes par ce locataire
  artisanRequests           ArtisanRequest[]
}

model TenantHousingHistory {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  housingId Int
  from      DateTime
  to        DateTime?
  housing   Housing       @relation(fields: [housingId], references: [id])
  tenant    TenantProfile @relation(fields: [tenantId], references: [id])
}

model Ticket {
  id                     Int                   @id @default(autoincrement())
  /// Numéro d'affaire lisible (ex. AFF-2026-000128) — recherche bailleur / notifications
  caseNumber             String?               @unique
  title                  String
  description            String
  status                 TicketStatus          @default(NEW)
  tenantId               Int
  housingId              Int
  /// Multi-tenant : recopié depuis Housing.landlordId à la création pour scope rapide
  landlordProfileId      Int?
  /// Classification IA produite par le pipeline (catégorie technique, sévérité, score)
  aiCategory             String?
  aiSeverity             String?
  aiConfidence           Float?
  aiSuggestedArtisanType String?
  /// Décision de routage du pipeline IA (PENDING tant que l'IA n'a pas tranché)
  responsibility         TicketResponsibility  @default(PENDING)
  /// Sous-catégorie en cas de NON_RECEVABLE (juridique voisin, assurance, etc.)
  nonRecevableReason     NonRecevableReason?
  /// Compteur des analyses IA déjà tentées (incrémenté à chaque re-photo)
  aiAttempts             Int                   @default(0)
  /// Seuil au-delà duquel le ticket est escaladé physiquement au bailleur (Q4=2)
  aiMaxAttempts          Int                   @default(2)
  /// Horodatage de l'escalade physique au bailleur (IA n'a pas pu trancher)
  escalatedAt            DateTime?
  /// Motif court de l'escalade (ex : "Photo floue x2")
  escalationReason       String?
  /// Trace JSON de la dernière décision IA (catégorie, confidence, pipelineSteps, etc.)
  aiLastDecision         Json?
  resolutionNote         String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  documents              Document[]
  planningSlots          PlanningSlot[]
  housing                Housing               @relation(fields: [housingId], references: [id])
  tenant                 TenantProfile         @relation(fields: [tenantId], references: [id])
  /// Cas social déclenché automatiquement par le routage IA (Sprint 5)
  socialCase             SocialCase?           @relation("TicketSocialCase")
  /// Sprint 4 : vidéos tutoriels proposées au locataire pour une décision LOCATAIRE
  videoSuggestions       TicketVideoSuggestion[]
  /// Sprint 4 : demande d'artisan envoyée à l'owner (toi) — 0 ou 1 par ticket
  artisanRequest         ArtisanRequest?
  /// Sprint F (LIA) — fil de conversation locataire ↔ hôte
  messages               TicketMessage[]

  @@index([caseNumber])
  @@index([landlordProfileId, status])
  @@index([responsibility])
  @@index([escalatedAt])
  @@index([tenantId])
}

/// ----------------------------------------------------------------------------
/// Sprint 4 — Vidéothèque IA + demandes d'artisan
/// ----------------------------------------------------------------------------

/// Recherche normalisée mémorisée par l'IA pour ne pas refaire la même requête
/// YouTube deux fois. Une query peut être réutilisée par plusieurs tickets.
model VideoTutorialQuery {
  id              Int              @id @default(autoincrement())
  /// Requête nettoyée (lower-case, ponctuation et stop-words retirés)
  queryNormalized String
  /// Catégorie technique associée (PLUMBING, ELECTRICITY, HUMIDITY, …)
  category        String
  /// Locale ciblée par la recherche (fr-FR par défaut Sprint 4)
  locale          String           @default("fr-FR")
  /// Nombre de tickets ayant déjà bénéficié de cette recherche
  hitCount        Int              @default(1)
  lastUsedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  videos          VideoTutorial[]

  @@unique([queryNormalized, locale])
  @@index([category])
}

/// Vidéo archivée — retournée par le port VideoSearch, conservée pour
/// les recherches futures et soumise à modération admin.
model VideoTutorial {
  id                Int                     @id @default(autoincrement())
  queryId           Int
  /// Identifiant YouTube (11 caractères) — clé de déduplication métier
  youtubeVideoId    String
  title             String
  channel           String?
  thumbnailUrl      String?
  /// Durée en secondes (utile pour filtrer les très longues vidéos)
  durationSec       Int?
  language          String                  @default("fr")
  /// Score de pertinence renvoyé par l'adapter (0 → 1)
  score             Float                   @default(0.5)
  /// Vidéo validée manuellement par l'admin → boostée dans le tri
  validatedByAdmin  Boolean                 @default(false)
  /// Vidéo blacklistée par l'admin → ne sera plus jamais proposée
  disabledByAdmin   Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  query             VideoTutorialQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  ticketSuggestions TicketVideoSuggestion[]

  @@unique([queryId, youtubeVideoId])
  @@index([disabledByAdmin])
}

/// Trace de la vidéo proposée à un ticket précis + retour locataire.
/// Utilisé pour les statistiques d'efficacité et la traçabilité RGPD.
model TicketVideoSuggestion {
  id              Int            @id @default(autoincrement())
  ticketId        Int
  videoTutorialId Int
  suggestedAt     DateTime       @default(now())
  /// Locataire a-t-il marqué la vidéo comme regardée ?
  tenantWatched   Boolean        @default(false)
  /// Locataire a-t-il jugé la vidéo utile (true) / pas utile (false) / inconnu (null) ?
  tenantHelpful   Boolean?
  /// Retour libre du locataire (court, plafonné à 1000 caractères)
  tenantFeedback  String?
  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  video           VideoTutorial  @relation(fields: [videoTutorialId], references: [id], onDelete: Cascade)

  @@unique([ticketId, videoTutorialId])
  @@index([ticketId])
}

/// Demande d'artisan générée par le locataire et envoyée à l'owner de la
/// plateforme (toi). N'est PAS gérée par le module artisans/ existant qui
/// concerne les prestataires bailleur — c'est un flux séparé pour le MVP.
model ArtisanRequest {
  id                Int                  @id @default(autoincrement())
  ticketId          Int                  @unique
  tenantId          Int
  /// Multi-tenant : on garde l'id du bailleur du logement pour scope et stats
  landlordProfileId Int
  category          String
  severity          String
  status            ArtisanRequestStatus @default(NEW)
  requestedAt       DateTime             @default(now())
  /// Notes internes saisies par l'admin (toi) lors du triage
  adminNotes        String?
  /// Créneau proposé par l'admin une fois le triage fait
  slotProposedAt    DateTime?
  /// Créneau confirmé par le locataire / l'admin
  slotConfirmedAt   DateTime?
  /// Date de fin de l'intervention artisan
  completedAt       DateTime?
  /// Raison saisie par le locataire au moment de la demande (optionnelle)
  tenantReason      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  ticket            Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant            TenantProfile        @relation(fields: [tenantId], references: [id])
  landlord          LandlordProfile      @relation(fields: [landlordProfileId], references: [id])

  @@index([status])
  @@index([landlordProfileId, status])
  @@index([tenantId])
}

model PlanningSlot {
  id                       Int       @id @default(autoincrement())
  artisanId                Int
  ticketId                 Int?
  startDate                DateTime
  endDate                  DateTime
  status                   String    @default("AVAILABLE")
  tenantConfirmationStatus String    @default("PENDING")
  reminderSent48h          Boolean   @default(false)
  reminderSentSameDay      Boolean   @default(false)
  signatureUrl             String?
  signedAt                 DateTime?
  createdAt                DateTime  @default(now())
  invoice                  Invoice?
  artisan                  User      @relation("PlanningSlotArtisan", fields: [artisanId], references: [id])
  ticket                   Ticket?   @relation(fields: [ticketId], references: [id])
}

model Invoice {
  id         Int          @id @default(autoincrement())
  slotId     Int          @unique
  landlordId Int
  amount     Float
  status     String       @default("PENDING")
  createdAt  DateTime     @default(now())
  landlord   User         @relation("InvoiceLandlord", fields: [landlordId], references: [id])
  slot       PlanningSlot @relation(fields: [slotId], references: [id])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// Sprint 6B — préférences utilisateur pour les canaux de notification.
model UserNotificationSettings {
  userId       Int     @id
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Sprint 6B — jetons FCM (ou autre) enregistrés par l'app mobile / web.
model DevicePushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String
  /// android | ios | web
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

/// Sprint 6A — activation des modules par bailleur (même codebase, périmètre variable).
model LandlordFeatureFlags {
  landlordProfileId      Int      @id
  ticketsModule          Boolean  @default(true)
  tenantOnboardingModule Boolean  @default(true)
  aiRoutingModule        Boolean  @default(true)
  videoLibraryModule     Boolean  @default(true)
  artisanRequestsModule  Boolean  @default(true)
  socialModule           Boolean  @default(true)
  hlmModule              Boolean  @default(false)
  contratsModule         Boolean  @default(true)
  paiementsModule        Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  landlord               LandlordProfile @relation(fields: [landlordProfileId], references: [id], onDelete: Cascade)
}

model Document {
  id        Int            @id @default(autoincrement())
  type      DocumentType
  url       String?
  content   String?
  ticketId  Int?
  housingId Int?
  tenantId  Int?
  createdAt DateTime       @default(now())
  housing   Housing?       @relation(fields: [housingId], references: [id])
  tenant    TenantProfile? @relation(fields: [tenantId], references: [id])
  ticket    Ticket?        @relation(fields: [ticketId], references: [id])
}

model SupportTicket {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  userId    Int
  subject   String
  message   String
  category  SupportCategory @default(GENERAL)
  priority  SupportPriority @default(LOW)
  status    String          @default("OPEN")
  autoReply String?
  user      User            @relation(fields: [userId], references: [id])
}

model SocialCase {
  id                     Int                  @id @default(autoincrement())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenantId               Int
  bailleurId             Int
  status                 SocialCaseStatus     @default(OPEN)
  category               SocialCaseCategory   @default(AUTRE)
  /// Notes internes (concaténation horodatée côté service — Sprint 5 P5)
  notes                  String?
  /// Ticket d'origine si le cas a été créé suite à un routage IA SOCIAL
  triggerTicketId        Int?                 @unique
  /// Référent social désigné (nullable tant que non pris en charge)
  assignedSocialWorkerId Int?
  priority               SocialCasePriority   @default(NORMAL)
  closedAt               DateTime?
  /// Obligatoire si status = CLOSED (Sprint 5)
  closedReason           String?
  lastContactAt          DateTime?
  bailleur               LandlordProfile      @relation(fields: [bailleurId], references: [id])
  tenant                   TenantProfile      @relation(fields: [tenantId], references: [id])
  triggerTicket            Ticket?            @relation("TicketSocialCase", fields: [triggerTicketId], references: [id])
  assignedWorker           SocialWorker?      @relation("SocialCaseAssignee", fields: [assignedSocialWorkerId], references: [id])
  events                   SocialCaseEvent[]

  @@index([bailleurId, status])
  @@index([tenantId])
  @@index([assignedSocialWorkerId])
}

model SocialCaseEvent {
  id           Int                 @id @default(autoincrement())
  createdAt    DateTime            @default(now())
  socialCaseId Int
  actorUserId  Int
  type         SocialCaseEventType
  payload      Json?
  socialCase   SocialCase          @relation(fields: [socialCaseId], references: [id], onDelete: Cascade)
  actor        User                @relation(fields: [actorUserId], references: [id])

  @@index([socialCaseId, createdAt])
}

model SocialWorker {
  id            Int         @id @default(autoincrement())
  userId        Int
  bailleurId    Int
  /// COORDINATOR | FIELD | EXTERNAL (valeurs validées en DTO — Sprint 5 P6)
  role          String
  bailleur      LandlordProfile @relation(fields: [bailleurId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  assignedCases SocialCase[]    @relation("SocialCaseAssignee")

  @@unique([userId, bailleurId])
}

model AiDiagnostic {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  /// SHA256(userId + salt) - jamais identifiant clair
  userHash          String
  locale            String   @db.VarChar(16)
  category          String   @db.VarChar(64)
  severity          String   @db.VarChar(16)
  target            String   @db.VarChar(24)
  refused           Boolean
  refusalReason     String?  @db.VarChar(512)
  diagnosticSummary String
  pipelineSteps     Json?
  avatarVariant     String?  @db.VarChar(32)
  artisanType       String?  @db.VarChar(64)
  bailleurFlag      Boolean  @default(false)
  adminFlag         Boolean  @default(false)

  @@index([createdAt])
  @@index([userHash])
  @@index([locale])
  @@index([refused])
  @@map("ai_diagnostics")
}

/// Fusion HLM — organisme patrimoine (UUID). Complète LandlordProfile via liaison optionnelle.
model HlmBailleur {
  id                    String            @id @default(uuid())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  corporateName         String
  siren                 String?           @db.VarChar(14)
  hasInternalGPAService Boolean           @default(false)
  gpaServiceEmail       String?
  gpaServicePhone       String?
  contactEmail          String?
  contactPhone          String?
  users                 HlmBailleurUser[]
  residences            HlmResidence[]
  landlordProfile       LandlordProfile?

  @@index([siren])
}

/// Fusion HLM — profils métiers bailleur / SSO
model HlmBailleurUser {
  id           String      @id @default(uuid())
  createdAt    DateTime    @default(now())
  bailleurId   String
  legacyUserId Int?
  role         String      @default("GESTIONNAIRE")
  bailleur     HlmBailleur @relation(fields: [bailleurId], references: [id], onDelete: Cascade)

  @@index([bailleurId])
  @@index([legacyUserId])
}

/// Fusion HLM — locataire métier UUID (distinct de TenantProfile legacy Int)
model HlmLocataire {
  id                    String               @id @default(uuid())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  firstName             String
  lastName              String
  email                 String?
  authSubject           String?              @unique
  legacyTenantProfileId Int?                 @unique
  entretienPreuves      HlmEntretienPreuve[]
  logements             HlmLogement[]        @relation("HlmLocataireOccupant")
  hlmTickets            HlmTicket[]
  tenantProfile         TenantProfile?

  @@index([legacyTenantProfileId])
}

/// Fusion HLM — résidence + garanties GPA / biennale / décennale (dates stockées)
model HlmResidence {
  id                                String        @id @default(uuid())
  createdAt                         DateTime      @default(now())
  updatedAt                         DateTime      @updatedAt
  name                              String
  bailleurId                        String
  constructionYear                  Int?
  deliveryDate                      DateTime      @db.Date
  residenceNeuve                    Boolean       @default(false)
  hasInternalGPAServicePerResidence Boolean       @default(false)
  gpaEndDate                        DateTime      @db.Date
  biennaleEndDate                   DateTime      @db.Date
  decennaleEndDate                  DateTime      @db.Date
  logements                         HlmLogement[]
  bailleur                          HlmBailleur   @relation(fields: [bailleurId], references: [id])

  @@index([bailleurId])
  @@index([deliveryDate])
  @@index([gpaEndDate])
  @@index([biennaleEndDate])
  @@index([decennaleEndDate])
}

/// Fusion HLM — unité de logement patrimoine (équipements / extérieurs). Pont optionnel vers Housing.
model HlmLogement {
  id                  String                 @id @default(uuid())
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  label               String
  externalRef         String?
  residenceId         String
  hasVmc              Boolean                @default(false)
  hasSolarWaterHeater Boolean                @default(false)
  hasCour             Boolean                @default(false)
  hasJardin           Boolean                @default(false)
  hasTerrasse         Boolean                @default(false)
  hasPatio            Boolean                @default(false)
  locataireId         String?
  locataire           HlmLocataire?          @relation("HlmLocataireOccupant", fields: [locataireId], references: [id])
  residence           HlmResidence           @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  entretiens          HlmLogementEntretien[]
  hlmTickets          HlmTicket[]
  housing             Housing?

  @@index([residenceId])
  @@index([locataireId])
}

/// Fusion HLM — catalogue types d’entretien
model HlmEntretienType {
  id                     String                 @id @default(uuid())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  code                   EntretienTypeCode      @unique
  labelFr                String
  description            String?
  frequency              MaintenanceFrequency
  requiresOutdoorContext Boolean                @default(false)
  checklistTemplates     HlmChecklistTemplate[]
  logementEntretiens     HlmLogementEntretien[]
}

/// Fusion HLM — modèle de checklist JSON par type
model HlmChecklistTemplate {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  entretienTypeId String
  items           Json
  version         Int              @default(1)
  entretienType   HlmEntretienType @relation(fields: [entretienTypeId], references: [id], onDelete: Cascade)

  @@index([entretienTypeId])
}

/// Fusion HLM — plan d’entretien par logement
model HlmLogementEntretien {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  logementId      String
  entretienTypeId String
  active          Boolean              @default(true)
  nextDueAt       DateTime?
  lastCompletedAt DateTime?
  preuves         HlmEntretienPreuve[]
  entretienType   HlmEntretienType     @relation(fields: [entretienTypeId], references: [id])
  logement        HlmLogement          @relation(fields: [logementId], references: [id], onDelete: Cascade)

  @@unique([logementId, entretienTypeId])
  @@index([logementId])
  @@index([nextDueAt])
}

/// Fusion HLM — preuves (2 photos obligatoires + checklist JSON + validations)
model HlmEntretienPreuve {
  id                  String                @id @default(uuid())
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  logementEntretienId String
  locataireId         String?
  checklist           Json
  photo1Url           String
  photo2Url           String
  validatedByAI       Boolean               @default(false)
  validatedByLandlord Boolean               @default(false)
  statut              EntretienPreuveStatut @default(BROUILLON)
  landlordValidatedAt DateTime?
  aiValidatedAt       DateTime?
  locataire           HlmLocataire?         @relation(fields: [locataireId], references: [id])
  logementEntretien   HlmLogementEntretien  @relation(fields: [logementEntretienId], references: [id], onDelete: Cascade)
  iaResults           HlmIAResult[]

  @@index([locataireId])
  @@index([logementEntretienId])
}

/// Modèle HLM fusionné — ticket socle (routage garanties / entretien). Ne remplace pas Ticket legacy.
model HlmTicket {
  id                      String                 @id @default(uuid())
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  title                   String
  description             String?
  category                HlmTicketCategory
  urgency                 HlmTicketUrgency       @default(NORMALE)
  status                  HlmTicketStatus        @default(BROUILLON)
  warrantyPhaseAtCreation WarrantyPhase?
  routingTarget           HlmTicketRoutingTarget @default(NONE)
  routingNotes            String?                @db.VarChar(1024)
  /// Alias métier demandé : blocage lié aux preuves d’entretien (synonyme historique blockedByMaintenance)
  entretienBlocked        Boolean                @default(false)
  blockedReason           String?                @db.VarChar(512)
  logementId              String
  locataireId             String?
  iaResults               HlmIAResult[]
  locataire               HlmLocataire?          @relation(fields: [locataireId], references: [id])
  logement                HlmLogement            @relation(fields: [logementId], references: [id])

  @@index([logementId])
  @@index([locataireId])
  @@index([status])
  @@index([routingTarget])
  @@index([createdAt])
  @@index([entretienBlocked])
}

/// Fusion HLM — résultats IA (analyse image, diagnostic, routage)
model HlmIAResult {
  id                String              @id @default(uuid())
  createdAt         DateTime            @default(now())
  kind              HlmIAResultKind
  imageAnalysis     Json?
  diagnostic        Json?
  routingIA         Json?
  confidence        Float?
  ticketId          String?
  entretienPreuveId String?
  modelVersion      String?             @default("v1")
  entretienPreuve   HlmEntretienPreuve? @relation(fields: [entretienPreuveId], references: [id])
  ticket            HlmTicket?          @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([entretienPreuveId])
  @@index([kind])
  @@index([createdAt])
}

/// Demande d'inscription self-service d'un locataire vers un bailleur (onboarding).
/// Le locataire saisit ses infos + l'adresse de son logement. Le bailleur valide
/// (création du TenantProfile + liaison/création du Housing) ou rejette (motif).
model TenantRegistrationRequest {
  id                       Int                       @id @default(autoincrement())
  userId                   Int
  landlordProfileId        Int
  /// Snapshot informations locataire au moment de la saisie
  firstName                String
  lastName                 String
  /// Snapshot informations logement (servent à créer Housing si absent du parc bailleur)
  address                  String
  building                 String?
  floor                    String?
  apartmentNumber          String?
  postalCode               String
  city                     City
  contractStartDate        DateTime?
  status                   TenantRequestStatus       @default(PENDING)
  /// Renseignés si APPROVED
  approvedTenantProfileId  Int?                      @unique
  approvedHousingId        Int?
  approvedAt               DateTime?
  /// Renseignés si REJECTED
  rejectedAt               DateTime?
  rejectionReason          String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  landlord                 LandlordProfile           @relation(fields: [landlordProfileId], references: [id], onDelete: Cascade)
  approvedTenantProfile    TenantProfile?            @relation("ApprovedTenantProfile", fields: [approvedTenantProfileId], references: [id], onDelete: SetNull)
  approvedHousing          Housing?                  @relation("ApprovedHousing", fields: [approvedHousingId], references: [id], onDelete: SetNull)

  @@index([landlordProfileId, status])
  @@index([userId])
  @@index([status])
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  BAILLEUR
  /// Agent rattaché à un bailleur (et optionnellement à une agence) — hérite du périmètre de son bailleur.
  AGENT
  LOCATAIRE
  /// Intervenants terrain (ex‑rôle ARTISAN — planning / facturation).
  PRESTATAIRE
}

/// Sprint F — messages du fil Lia (locataire / hôte).
enum TicketMessageRole {
  TENANT
  LIA_HOST
  LIA_SYSTEM
}

model TicketMessage {
  id        Int               @id @default(autoincrement())
  ticketId  Int
  role      TicketMessageRole
  content   String
  locale    String            @default("fr-FR")
  createdAt DateTime          @default(now())
  ticket    Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Sprint F — base de connaissances juridique / résidence (RAG juriste).
enum AiMemoryKind {
  DECRET
  RESIDENCE_ARCHIVE
  FAQ_BAILLEUR
}

model AiMemory {
  id                Int          @id @default(autoincrement())
  landlordProfileId Int?
  housingId         Int?
  kind              AiMemoryKind
  title             String
  content           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([landlordProfileId, kind])
  @@index([housingId])
}

enum TicketStatus {
  /// Vient d'être créé, pipeline IA pas encore lancé
  NEW
  /// Lia a accueilli le locataire ; pathologiste/juriste en cours (app peut être fermée)
  LIA_ANALYZING
  /// IA a demandé une nouvelle photo au locataire, en attente de re-upload
  AWAITING_TENANT_PHOTO
  /// Ticket actif (routé vers BAILLEUR / LOCATAIRE / SOCIAL / ESCALADE)
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
  /// Fermé automatiquement par l'IA (NON_RECEVABLE). Réouvrable via revue humaine.
  AUTO_CLOSED
}

/// Décision de routage produite par le pipeline IA (cœur du Sprint 3)
enum TicketResponsibility {
  /// IA pas encore passée (juste créé) ou en cours d'analyse
  PENDING
  /// Charge bailleur : structure, parties communes, vétusté, gros entretien
  BAILLEUR
  /// Charge locataire : entretien courant, dégradation locative
  LOCATAIRE
  /// Non recevable : litige voisin, sinistre assurance, hors-périmètre app
  NON_RECEVABLE
  /// Volet social : impayé de loyer, surendettement, médiation paiement
  SOCIAL
  /// IA n'a pas pu trancher après aiMaxAttempts → déplacement bailleur requis
  ESCALADE_BAILLEUR
}

/// Sous-catégorie pour NON_RECEVABLE — alimente le compteur bailleur (Sprint 5)
/// et oriente le message contextuel renvoyé au locataire.
enum NonRecevableReason {
  JURIDIQUE_VOISIN
  ASSURANCE_DEGATS_EAUX
  ASSURANCE_AUTRE
  HORS_LOGEMENT
  HORS_PERIMETRE_APP
  AUTRE
}

/// Sprint 4 — Cycle de vie d'une demande d'artisan envoyée à l'owner.
enum ArtisanRequestStatus {
  /// Vient d'être créée par le locataire
  NEW
  /// Triagée par l'admin (qualifiée, en attente de proposition d'artisan)
  TRIAGED
  /// Un artisan a été contacté et un créneau est proposé / planifié
  IN_PROGRESS
  /// Intervention terminée
  DONE
  /// Annulée (par le locataire ou par l'admin)
  CANCELLED
}

